# Vorbereitung ----
rm(list = ls()) # Workspace loeschen
options(scipen = 999) # schaltet wissenschaftliche Schreibweise aus
# Pakete ----
# install.packages("cluster")
library(tidyverse)
library(reshape2) # für dcast, datawranggling
library(ggplot2)
library(openxlsx)
library(FactoMineR)
library(cluster)
library(ggrepel) # für geom_text_repel
# Daten einlesen ----
datum <- gsub("-", "", Sys.Date())
path_stamm <- "P:/diss/quali_Befragung_Spiel/" # @change
dat <- read.xlsx(paste0(path_stamm, "hs_auswahl_vignetten_20251127.xlsx"), sheet = "20251031_k")[1:18,]
str(dat)
colnames(dat)
l.cod <- read.xlsx(paste0(path_stamm, "hs_auswahl_vignetten_20251127.xlsx"), sheet = "var_auspr_20251007")[1:8,]
# MCA ----
mca1 <- MCA(dat %>% select(elt_bild, elt_bp,
stud_dist, stud_dist_we, stud_gr,
hs_grzeit, hs_rang, hs_gr, hs_wirt, hs_we,
hs_grmerk, hs_typ, hs_voll), graph = T, quali.sup = c(12, 13)) #
# Anzahl Dimensionen
# Trägheit (Erklärungsbeitrag einer Achse an der gesamten Streuungsinformation)
# Eigenwerte, "Screeplot": Anzahl Achsen
plot(mca1$eig[, "percentage of variance"]) # Knick bei zwei -> es braucht zwei Achsen
# Plot ---
# aktive
plot.MCA(mca1, axes = c(1, 2), new.plot = T, # Achsen wählen,
label = c("var"), # Labels ausgeben für... (wenn nicht genannt, keine Labels)
title = "V1",  invisible = c("ind", "quali.sup"), # Titel und unsichtabr Individuen und passive Variablen, passiv auch unsichtbar: , "quali"
# ylim = range(), xlim = range(),
cex = 1.1, autoLab = "yes", habillage = "quali",
# col.ind = "black", col.var = "black", col.quali.sup = "black", # Farben angeben für aktive Variablen, Individuen und passive Variablen
graph.type = "ggplot") # ermöglicht ggoptions
# passive
plot.MCA(mca1, axes = c(1, 2), new.plot = T, # Achsen wählen,
label = c("quali.sup"), # Labels ausgeben für... (wenn nicht genannt, keine Labels)
title = "V1, passive Variablen",  invisible = c("ind"), # Titel und unsichtabr Individuen und passive Variablen, passiv auch unsichtbar: , "quali"
# ylim = range(), xlim = range(),
cex = 1.1, col.quali.sup = "black",
# col.ind = "black", col.var = "black", col.quali.sup = "black", # Farben angeben für aktive Variablen, Individuen und passive Variablen
graph.type = "ggplot",
habillage = "quali")
d.ind.cl <- as.data.frame(mca1$ind$coord[, c("Dim 1", "Dim 2")]) %>%
setNames(c("dim1", "dim2")) %>%
mutate(cluster = as.character(cl.x$cluster)) %>%
rownames_to_column(var = "ind") %>%
left_join(dat %>% rownames_to_column(var = "ind") %>% select(ind, hs_kurz), by = "ind") %>%
left_join(as.data.frame(silhouette(cl.x$cluster, dist(mca1$ind$coord[, c("Dim 1", "Dim 2")]))) %>%
rownames_to_column(var = "ind") %>%
select(-cluster), by = "ind")
d.ind.cl %>%
group_by(cluster) %>%
summarise(sum_sil = sum(sil_width),
n = n(),
avg_sil = sum_sil / n)
# weiteres Kriterium: höchster Durchschnittswert bei silhouette-Wert
# sil <- rep(0, 18)
# for(i in 1:17){
#   sil[i] <- mean(silhouette(kmeans(mca1$ind$coord[, c("Dim 1", "Dim 2")], i)$cluster, dist(mca1$ind$coord[, c("Dim 1", "Dim 2")])), na.rm = T)
# }
# plot(1:18, sil, type = "b", xlab = "", ylab = "")
# macht nicht Sinn - mean(sil) steigt einfach, je mehr Cluster...
cl.x <- kmeans(mca1$ind$coord[, c("Dim 1", "Dim 2")], 3)
plot(mca1$ind$coord[, c("Dim 1", "Dim 2")], col = cl.x$cluster)
points(cl.x$centers, col = 1:3, pch = 8, cex = 2)
plot(silhouette(cl.x$cluster, dist(mca1$ind$coord[, c("Dim 1", "Dim 2")])))
d.ind.cl <- as.data.frame(mca1$ind$coord[, c("Dim 1", "Dim 2")]) %>%
setNames(c("dim1", "dim2")) %>%
mutate(cluster = as.character(cl.x$cluster)) %>%
rownames_to_column(var = "ind") %>%
left_join(dat %>% rownames_to_column(var = "ind") %>% select(ind, hs_kurz), by = "ind") %>%
left_join(as.data.frame(silhouette(cl.x$cluster, dist(mca1$ind$coord[, c("Dim 1", "Dim 2")]))) %>%
rownames_to_column(var = "ind") %>%
select(-cluster), by = "ind")
d.ind.cl %>%
group_by(cluster) %>%
summarise(sum_sil = sum(sil_width),
n = n(),
avg_sil = sum_sil / n)
# Resultate von kmeans prüfen mit Silhouette Plot (je länger die Balken, desto homogener)
# Länge entspricht Nähe des Obj. zu seinem Cluster verglichen mit Distanz zum nächsten Nachbar-Cluster [-1, 1]
ggplot(data = d.ind.cl %>%
group_by(cluster) %>%
mutate(hs_kurz = fct_reorder(hs_kurz, sil_width, .desc = TRUE)),
mapping = aes(x = hs_kurz, y = sil_width)) +
geom_bar(stat = "identity", aes(fill = cluster)) +
scale_fill_manual(labels = 1:3, values = c("#1b9e77","#d95f02", "#7570b3"), name = "Cluster") +
geom_hline(yintercept = 0.7) +
geom_hline(yintercept = 0.5) +
geom_hline(yintercept = 0.25) +
ylim(c(0, 1)) +
xlab("Hochschule") +
ylab("Silhouette Width") + # wie ähnlich eine Hochschule ihrem Cluster ist im Vergleich zu nächsten alternativen Cluster
ggtitle("Silhouette-Plot") +
# geom_hline(yintercept = mean(d.ind.cl$sil_width), col = "blue") +
theme_bw()
ggplot() + # var statt ind für Variablen...
geom_hline(yintercept = 0, colour = "gray70") + # 1. Dimension
geom_vline(xintercept = 0, colour = "gray70") + # 2. Dimension
geom_point(data = data.frame(mca1$var$coord), aes(x = Dim.1, y = Dim.2), size = 0.75) + # Punkte für Ausprägungen
ggrepel::geom_text_repel(data = data.frame(mca1$var$coord),aes(x = Dim.1, y = Dim.2, label = rownames(data.frame(mca1$var$coord))),
min.segment.length = 0, size = 5,
force = 10, direction = "y") + # Beschriftung
geom_density2d(data = data.frame(mca1$var$coord), aes(x = Dim.1, y = Dim.2), colour = "gray80") + # Dichtelinien, Perform a 2D kernel density estimation using MASS::kde2d():
# finite sample of data -> inferences about the underlying probability density function everywhere
ggrepel::geom_text_repel(data = d.ind.cl, aes(x = dim1, y = dim2, col = cluster, label = hs_kurz),
min.segment.length = 0, size = 5,
force = 10, direction = "y") +
geom_point(data = d.ind.cl, aes(x = dim1, y = dim2, col = cluster), size = 0.75) + # Punkte für Individuen (hier HS)
scale_color_manual(labels = 1:3, values = c("#1b9e77","#d95f02", "#7570b3")) +
guides(colour = guide_legend(title = "Cluster", override.aes = list(shape = 15, size = 5))) +
ggtitle("MCA-Plot mit ggplot") + # Titel
xlab(paste0("Dim 1 (", round(mca1$eig[, "percentage of variance"], 2), "%)")[1]) +
ylab(paste0("Dim 2 (", round(mca1$eig[, "percentage of variance"], 2), "%)")[2]) +
theme_bw()
ggplot() + # var statt ind für Variablen...
# geom_hline(yintercept = 0, colour = "gray70") + # 1. Dimension
# geom_vline(xintercept = 0, colour = "gray70") + # 2. Dimension
geom_point(data = data.frame(mca1$var$coord), aes(x = Dim.1, y = Dim.2), size = 0.75)
ggplot() + # var statt ind für Variablen...
# geom_hline(yintercept = 0, colour = "gray70") + # 1. Dimension
# geom_vline(xintercept = 0, colour = "gray70") + # 2. Dimension
# geom_point(data = data.frame(mca1$var$coord), aes(x = Dim.1, y = Dim.2), size = 0.75) + # Punkte für Ausprägungen
ggrepel::geom_text_repel(data = data.frame(mca1$var$coord),aes(x = Dim.1, y = Dim.2, label = rownames(data.frame(mca1$var$coord))),
min.segment.length = 0, size = 5,
force = 10, direction = "y") + # Beschriftung
geom_density2d(data = data.frame(mca1$var$coord), aes(x = Dim.1, y = Dim.2), colour = "gray80")
ggplot() + # var statt ind für Variablen...
# geom_hline(yintercept = 0, colour = "gray70") + # 1. Dimension
# geom_vline(xintercept = 0, colour = "gray70") + # 2. Dimension
# geom_point(data = data.frame(mca1$var$coord), aes(x = Dim.1, y = Dim.2), size = 0.75) + # Punkte für Ausprägungen
ggrepel::geom_text_repel(data = data.frame(mca1$var$coord),aes(x = Dim.1, y = Dim.2, label = rownames(data.frame(mca1$var$coord))),
min.segment.length = 0, size = 5,
force = 10, direction = "y") + # Beschriftung
