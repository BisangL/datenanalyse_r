# gesamte Ablage durchsuchen
# Vorbereitung ----
rm(list = ls()) # Workspace loeschen
options(scipen = 999) # schaltet wissenschaftliche Schreibweise aus
library(dplyr)
library(stringr)
library(stringi)
library(officer)
library(pdftools)
# Einlesen ----
datum <- gsub("-", "", Sys.Date()) # gsub("-", "", Sys.Date() + 1)
pfad.leist <- "P:/lehre/hs26_datenanalyse_r/leistungen/aufg_"
pfad.leist.tag <- paste0(pfad.leist, datum, "/")
datei <- list.files(pfad.leist.tag, recursive = TRUE) %>%
as.data.frame(.) %>%
setNames("pfad") %>%
mutate(pfad = paste0(pfad.leist.tag, pfad)) %>%
filter(grepl("\\.pdf", pfad))
pdf.ready <- matrix(ncol = dim(datei)[1], nrow = 1)
for(i in 1:dim(datei)[1]){ #
pdf.ready[, i] <- gsub("- ", "", gsub("\b", " ", gsub("\\n", " ", paste(pdftools::pdf_text(datei$pfad[i]), collapse = ";"))))
names(pdf.ready)[i] <- strsplit(datei$pfad[i], split = "/")[[1]][7]
}
d.pdf.ready <- as.data.frame(pdf.ready) %>%
setNames(attributes(pdf.ready)$names)
# ab Stichwort
for(j in 1:dim(datei)[1]){ #
d.pdf.ready[2, j] <- strsplit(x = as.character(d.pdf.ready[, j]), split = "eflexion", fixed = T)[[1]][2]
}
# als Word speichern ----
word.doc <- read_docx()
for(l in 1: dim(d.pdf.ready)[2]){
word.doc %>%
body_add_par(colnames(d.pdf.ready)[l]) %>%
body_add_par(d.pdf.ready[2, l])
}
print(word.doc, target = paste0(pfad.leist.tag, "reflexionen", ".docx"))
?rnorm
quarto::quarto_version()
# gesamte Ablage durchsuchen
# Vorbereitung ----
rm(list = ls()) # Workspace loeschen
options(scipen = 999) # schaltet wissenschaftliche Schreibweise aus
library(dplyr)
library(stringr)
library(stringi)
library(officer)
library(pdftools)
# Einlesen ----
datum <- gsub("-", "", Sys.Date()) # gsub("-", "", Sys.Date() + 1)
pfad.leist <- "P:/lehre/hs26_datenanalyse_r/leistungen/aufg_"
pfad.leist.tag <- paste0(pfad.leist, datum, "/")
datei <- list.files(pfad.leist.tag, recursive = TRUE) %>%
as.data.frame(.) %>%
setNames("pfad") %>%
mutate(pfad = paste0(pfad.leist.tag, pfad)) %>%
filter(grepl("\\.pdf", pfad))
pdf.ready <- matrix(ncol = dim(datei)[1], nrow = 1)
for(i in 1:dim(datei)[1]){ #
pdf.ready[, i] <- gsub("- ", "", gsub("\b", " ", gsub("\\n", " ", paste(pdftools::pdf_text(datei$pfad[i]), collapse = ";"))))
names(pdf.ready)[i] <- strsplit(datei$pfad[i], split = "/")[[1]][7]
}
d.pdf.ready <- as.data.frame(pdf.ready) %>%
setNames(attributes(pdf.ready)$names)
# ab Stichwort
for(j in 1:dim(datei)[1]){ #
d.pdf.ready[2, j] <- strsplit(x = as.character(d.pdf.ready[, j]), split = "eflexion", fixed = T)[[1]][2]
}
# als Word speichern ----
word.doc <- read_docx()
for(l in 1: dim(d.pdf.ready)[2]){
word.doc %>%
body_add_par(colnames(d.pdf.ready)[l]) %>%
body_add_par(d.pdf.ready[2, l])
}
print(word.doc, target = paste0(pfad.leist.tag, "reflexionen", ".docx"))
source(file = "C:/Users/BisangL/Documents/c_fuer_quarto/skripts/datenaufbereitung_ess11.R")
# Vorbereitung ----
rm(list = ls()) # Workspace loeschen
options(scipen = 999) # schaltet wissenschaftliche Schreibweise aus
# Pakete laden ----
library(openxlsx)
# Daten einlesen und auswählen ----
d.bsp <- read.xlsx("C:/Users/BisangL/Documents/c_fuer_quarto/buch_hs25/daten/bsp_dat.xlsx")
colnames(d.bsp) <- c("date", "rec", "score", "rest", "batt", "rec_rol", "rec_dur", "ev1", "ev2")
d.bsp.k <- d.bsp[, c("rec", "batt", "ev1", "score", "ev2")]
# bereinigen ----
str(d.bsp.k)
d.bsp.k$ev1 <- factor(d.bsp.k$ev1, levels = c(0, 1), labels = c("nein", "ja"))
d.bsp.k$ev2 <- factor(d.bsp.k$ev2, levels = c(0, 1), labels = c("nein", "ja"))
# Datenanalyse ----
# num - num
# deskriptiv-visuell
plot(d.bsp.k$rec, d.bsp.k$batt, xlim = c(0, 45), ylim = c(0, 70))
abline(reg = lm(batt ~ rec, data = d.bsp.k))
# lin. Reg.
fit.1 <- lm(batt ~ rec, data = d.bsp.k)
summary(fit.1)
# num - kat
# deskriptiv-visuell
plot(d.bsp.k$ev1, d.bsp.k$rec) # , ylim = c(0, 45)
plot(d.bsp.k$ev2, d.bsp.k$score)
# lin. Reg.
fit.2 <- lm(score ~ ev2, data = d.bsp.k)
summary(fit.2)
plot(fit.1)
plot(fit.2)
